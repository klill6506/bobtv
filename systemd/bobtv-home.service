[Unit]
Description=BobTV local home screen
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/ken/Documents/ChatGPT/BobTV
ExecStart=/usr/bin/python3 "/home/ken/Documents/ChatGPT/BobTV/bobtv.py" serve
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
